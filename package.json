{
  "name": "picodev-ctf",
  "displayName": "Picodev CTF",
  "description": "Write Picodev CTF challenges from VS Code (author tools), and send your program to the bench of your game from the challenge's container.",
  "version": "0.1.0",
  "publisher": "picodev",
  "icon": "media/logo.png",
  "galleryBanner": {
    "color": "#0d2240",
    "theme": "dark"
  },
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/PICODEV-SAS/picodev-ctf-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/PICODEV-SAS/picodev-ctf-vscode/issues"
  },
  "homepage": "https://github.com/PICODEV-SAS/picodev-ctf-vscode#readme",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Education",
    "AI",
    "Other"
  ],
  "keywords": [
    "ctf",
    "picodev",
    "embedded",
    "firmware",
    "arduino",
    "zephyr",
    "mcp"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onMcpCollection:picodev-ctf-author"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "picodev-ctf-author",
        "label": "Picodev CTF (author)"
      }
    ],
    "commands": [
      { "command": "picodevCtf.setToken", "title": "%command.setToken%", "category": "Picodev CTF" },
      { "command": "picodevCtf.forgetToken", "title": "%command.forgetToken%", "category": "Picodev CTF" },
      { "command": "picodevCtf.newChallenge", "title": "%command.newChallenge%", "category": "Picodev CTF" },
      { "command": "picodevCtf.openDraft", "title": "%command.openDraft%", "category": "Picodev CTF" },
      { "command": "picodevCtf.send", "title": "%command.send%", "category": "Picodev CTF" },
      { "command": "picodevCtf.check", "title": "%command.check%", "category": "Picodev CTF" },
      { "command": "picodevCtf.try", "title": "%command.try%", "category": "Picodev CTF" },
      { "command": "picodevCtf.solve", "title": "%command.solve%", "category": "Picodev CTF" },
      { "command": "picodevCtf.submit", "title": "%command.submit%", "category": "Picodev CTF" },
      { "command": "picodevCtf.comments", "title": "%command.comments%", "category": "Picodev CTF" },
      { "command": "picodevCtf.login", "title": "%command.login%", "category": "Picodev CTF" },
      { "command": "picodevCtf.playerSend", "title": "%command.playerSend%", "category": "Picodev CTF" },
      { "command": "picodevCtf.status", "title": "%command.status%", "category": "Picodev CTF" },
      { "command": "picodevCtf.openStarter", "title": "%command.openStarter%", "category": "Picodev CTF" }
    ],
    "configuration": {
      "title": "Picodev CTF",
      "properties": {
        "picodevCtf.url": {
          "type": "string",
          "default": "https://ctf.picodev.fr",
          "pattern": "^https://",
          "description": "%config.url%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p . --noEmit && esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=out/extension.js",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node test/run.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "1.101.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "l10n": "./l10n",
  "vsce": {
    "dependencies": false
  }
}
