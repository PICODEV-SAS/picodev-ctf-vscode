{
  "name": "picodev-ctf",
  "displayName": "Picodev CTF",
  "description": "Play Picodev CTF challenges from VS Code (join, build, send to the bench, watch the game) and write challenges (author tools).",
  "version": "0.5.0",
  "publisher": "picodev",
  "icon": "media/logo.png",
  "galleryBanner": {
    "color": "#0d2240",
    "theme": "dark"
  },
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/PICODEV-SAS/picodev-ctf-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/PICODEV-SAS/picodev-ctf-vscode/issues"
  },
  "homepage": "https://github.com/PICODEV-SAS/picodev-ctf-vscode#readme",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Education",
    "AI",
    "Other"
  ],
  "keywords": [
    "ctf",
    "picodev",
    "embedded",
    "firmware",
    "arduino",
    "zephyr",
    "mcp"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri",
    "onMcpCollection:picodev-ctf-author"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "picodev-ctf-author",
        "label": "Picodev CTF (author)"
      }
    ],
    "commands": [
      {
        "command": "picodevCtf.setToken",
        "title": "%command.setToken%",
        "category": "Picodev CTF"
      },
      {
        "command": "picodevCtf.forgetToken",
        "title": "%command.forgetToken%",
        "category": "Picodev CTF"
      },
      {
        "command": "picodevCtf.newChallenge",
        "title": "%command.newChallenge%",
        "category": "Picodev CTF"
      },
      {
        "command": "picodevCtf.openDraft",
        "title": "%command.openDraft%",
        "category": "Picodev CTF"
      },
      {
        "command": "picodevCtf.send",
        "title": "%command.send%",
        "category": "Picodev CTF"
      },
      {
        "command": "picodevCtf.check",
        "title": "%command.check%",
        "category": "Picodev CTF"
      },
      {
        "command": "picodevCtf.try",
        "title": "%command.try%",
        "category": "Picodev CTF"
      },
      {
        "command": "picodevCtf.solve",
        "title": "%command.solve%",
        "category": "Picodev CTF"
      },
      {
        "command": "picodevCtf.submit",
        "title": "%command.submit%",
        "category": "Picodev CTF"
      },
      {
        "command": "picodevCtf.comments",
        "title": "%command.comments%",
        "category": "Picodev CTF"
      },
      {
        "command": "picodevCtf.login",
        "title": "%command.login%",
        "category": "Picodev CTF",
        "icon": "$(sign-in)"
      },
      {
        "command": "picodevCtf.playerSend",
        "title": "%command.playerSend%",
        "category": "Picodev CTF",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "picodevCtf.status",
        "title": "%command.status%",
        "category": "Picodev CTF",
        "icon": "$(refresh)"
      },
      {
        "command": "picodevCtf.openStarter",
        "title": "%command.openStarter%",
        "category": "Picodev CTF"
      },
      {
        "command": "picodevCtf.launch",
        "title": "%command.launch%",
        "category": "Picodev CTF",
        "icon": "$(search)"
      },
      {
        "command": "picodevCtf.build",
        "title": "%command.build%",
        "category": "Picodev CTF",
        "icon": "$(tools)"
      },
      {
        "command": "picodevCtf.watch",
        "title": "%command.watch%",
        "category": "Picodev CTF",
        "icon": "$(eye)"
      },
      {
        "command": "picodevCtf.console",
        "title": "%command.console%",
        "category": "Picodev CTF",
        "icon": "$(terminal)"
      },
      {
        "command": "picodevCtf.gameScreen",
        "title": "%command.gameScreen%",
        "category": "Picodev CTF",
        "icon": "$(link-external)"
      },
      {
        "command": "picodevCtf.hint",
        "title": "%command.hint%",
        "category": "Picodev CTF",
        "icon": "$(lightbulb)"
      },
      {
        "command": "picodevCtf.abandon",
        "title": "%command.abandon%",
        "category": "Picodev CTF",
        "icon": "$(close)"
      },
      {
        "command": "picodevCtf.courses",
        "title": "%command.courses%",
        "category": "Picodev CTF",
        "icon": "$(book)"
      },
      {
        "command": "picodevCtf.joinPending",
        "title": "%command.joinPending%",
        "category": "Picodev CTF",
        "icon": "$(sign-in)"
      },
      {
        "command": "picodevCtf.signIn",
        "title": "%command.signIn%",
        "category": "Picodev CTF",
        "icon": "$(account)"
      },
      {
        "command": "picodevCtf.signOut",
        "title": "%command.signOut%",
        "category": "Picodev CTF",
        "icon": "$(sign-out)"
      },
      {
        "command": "picodevCtf.openCourse",
        "title": "%command.openCourse%",
        "category": "Picodev CTF",
        "icon": "$(book)"
      },
      {
        "command": "picodevCtf.markRead",
        "title": "%command.markRead%",
        "category": "Picodev CTF",
        "icon": "$(check)"
      }
    ],
    "configuration": {
      "title": "Picodev CTF",
      "properties": {
        "picodevCtf.url": {
          "type": "string",
          "default": "https://ctf.picodev.fr",
          "pattern": "^(https://|http://(localhost|127\\.0\\.0\\.1)(:[0-9]+)?/?$)",
          "description": "%config.url%",
          "scope": "machine"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "picodevCtf",
          "title": "Picodev CTF",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "picodevCtf": [
        {
          "id": "picodevCtf.actions",
          "name": "%view.actions%"
        },
        {
          "id": "picodevCtf.game",
          "name": "%view.game%"
        },
        {
          "id": "picodevCtf.courses",
          "name": "%view.courses%"
        },
        {
          "id": "picodevCtf.author",
          "name": "%view.author%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "picodevCtf.game",
        "when": "!picodevCtf.picodev && !picodevCtf.pending",
        "contents": "%welcome.game.noPicodev%"
      },
      {
        "view": "picodevCtf.game",
        "when": "picodevCtf.picodev && !picodevCtf.pending",
        "contents": "%welcome.game.none%"
      },
      {
        "view": "picodevCtf.game",
        "when": "picodevCtf.picodev && picodevCtf.pending",
        "contents": "%welcome.game.pending%"
      },
      {
        "view": "picodevCtf.game",
        "when": "!picodevCtf.picodev && picodevCtf.pending",
        "contents": "%welcome.game.pendingStarter%"
      },
      {
        "view": "picodevCtf.courses",
        "contents": "%welcome.courses%"
      },
      {
        "view": "picodevCtf.author",
        "contents": "%welcome.author%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "picodevCtf.joinPending",
          "when": "picodevCtf.pending"
        },
        {
          "command": "picodevCtf.signOut",
          "when": "picodevCtf.signedIn"
        }
      ],
      "view/title": [
        {
          "command": "picodevCtf.build",
          "when": "view == picodevCtf.actions && picodevCtf.game",
          "group": "navigation@1"
        },
        {
          "command": "picodevCtf.playerSend",
          "when": "view == picodevCtf.actions && picodevCtf.game",
          "group": "navigation@2"
        },
        {
          "command": "picodevCtf.watch",
          "when": "view == picodevCtf.actions && picodevCtf.game",
          "group": "navigation@3"
        },
        {
          "command": "picodevCtf.gameScreen",
          "when": "view == picodevCtf.actions && picodevCtf.game",
          "group": "navigation@4"
        },
        {
          "command": "picodevCtf.launch",
          "when": "view == picodevCtf.actions && !picodevCtf.game",
          "group": "navigation@1"
        },
        {
          "command": "picodevCtf.status",
          "when": "view == picodevCtf.game && picodevCtf.picodev",
          "group": "navigation@1"
        },
        {
          "command": "picodevCtf.signIn",
          "when": "view == picodevCtf.courses && !picodevCtf.signedIn",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "picodevCtf.playerSend",
          "when": "picodevCtf.game && resourceScheme == file",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "picodevCtf.markRead",
          "when": "view == picodevCtf.courses && viewItem == course && picodevCtf.signedIn",
          "group": "inline"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "picodevCtf.play",
        "title": "%walkthrough.play.title%",
        "description": "%walkthrough.play.description%",
        "steps": [
          {
            "id": "docker",
            "title": "%walkthrough.docker.title%",
            "description": "%walkthrough.docker.description%",
            "media": {
              "svg": "%walkthrough.docker.svg%",
              "altText": "%walkthrough.docker.alt%"
            },
            "completionEvents": [
              "extensionInstalled:ms-vscode-remote.remote-containers"
            ]
          },
          {
            "id": "launch",
            "title": "%walkthrough.launch.title%",
            "description": "%walkthrough.launch.description%",
            "media": {
              "svg": "%walkthrough.launch.svg%",
              "altText": "%walkthrough.launch.alt%"
            },
            "completionEvents": [
              "onCommand:picodevCtf.launch"
            ]
          },
          {
            "id": "open",
            "title": "%walkthrough.open.title%",
            "description": "%walkthrough.open.description%",
            "media": {
              "svg": "%walkthrough.open.svg%",
              "altText": "%walkthrough.open.alt%"
            },
            "completionEvents": [
              "onCommand:picodevCtf.openStarter",
              "onCommand:picodevCtf.login",
              "onCommand:picodevCtf.joinPending"
            ]
          },
          {
            "id": "build",
            "title": "%walkthrough.build.title%",
            "description": "%walkthrough.build.description%",
            "media": {
              "svg": "%walkthrough.build.svg%",
              "altText": "%walkthrough.build.alt%"
            },
            "completionEvents": [
              "onCommand:picodevCtf.build",
              "onCommand:picodevCtf.playerSend"
            ]
          },
          {
            "id": "console",
            "title": "%walkthrough.console.title%",
            "description": "%walkthrough.console.description%",
            "media": {
              "svg": "%walkthrough.console.svg%",
              "altText": "%walkthrough.console.alt%"
            },
            "completionEvents": [
              "onCommand:picodevCtf.console"
            ]
          },
          {
            "id": "flag",
            "title": "%walkthrough.flag.title%",
            "description": "%walkthrough.flag.description%",
            "media": {
              "svg": "%walkthrough.flag.svg%",
              "altText": "%walkthrough.flag.alt%"
            },
            "completionEvents": [
              "onCommand:picodevCtf.gameScreen"
            ]
          }
        ]
      }
    ],
    "markdown.markdownItPlugins": true
  },
  "scripts": {
    "compile": "tsc -p . --noEmit && esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=out/extension.js",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node test/run.js",
    "logo": "node scripts/logo.js"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.101.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "l10n": "./l10n",
  "vsce": {
    "dependencies": false
  }
}
